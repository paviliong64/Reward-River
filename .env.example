# ==============================================================================
# Reward River Environment Configuration (.env.example)
# Copy this file to .env and configure with your production credentials.
# NEVER commit your real .env file or private keys to source control!
# ==============================================================================

# Application Environment & URLs
NODE_ENV=production
PORT=3000
APP_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-sessions"

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database & Auth Configuration
# Get your Supabase URL, Anon Key, and Service Role Key from:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# CPX Research Publisher Credentials
# ------------------------------------------------------------------------------
CPX_APP_ID="37479"
CPX_HASH_KEY="yTrC9mntJwV1PSRJ5WdMbwMSel6qMheY"

# ------------------------------------------------------------------------------
# AoyTasks / Aoyco Publisher Credentials & Webhook Settings
# Documentation: https://aoyco.in/offerwall_doc.html
# Offerwall URL format: https://aoyco.in/offerwall/[API_KEY]/[USER_ID]
# S2S Postback Webhook: https://rewardriver.online/wh/aoytasks
# ------------------------------------------------------------------------------
AOY_API_KEY="223f26cc088f5bab7b79022b1d728e7d45106754ea0d38aa"
AOY_SECRET_KEY="8541bec43fd15ef8996554a07ef7c8942300227cecfdbe6408e26969c77b4e92"
AOY_BEARER_TOKEN=""
AOY_EXCHANGE_RATE="10000"

# ------------------------------------------------------------------------------
# Tether (USDT) Payout & Network Configuration
# ------------------------------------------------------------------------------
USDT_DEFAULT_NETWORK="TRC20"
USDT_MIN_WITHDRAWAL_USD=25.00
USDT_MAX_WITHDRAWAL_USD=500.00
USDT_TRC20_FEE_USD=1.00
USDT_ERC20_FEE_USD=2.50

# ------------------------------------------------------------------------------
# Cloudflare Turnstile CAPTCHA (Bot Protection)
# Testing Site Key (always passes): 1x00000000000000000000AA
# Testing Secret Key: 1x0000000000000000000000000000000AA
# ------------------------------------------------------------------------------
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY="0x4AAAAAAFsriP1bMbtMNkub"
CLOUDFLARE_TURNSTILE_SECRET_KEY="0x4AAAAAAFsriCiA5xJEhvolMVq96CWpRdw"

# ------------------------------------------------------------------------------
# TimeWall.io Offerwall Integration, Survey API & S2S Postback Security
# Placement Edit URL: https://siteowner.timewall.io/placements/add?oid=bbaca457a255e3e2&edit=1
# S2S Survey API Endpoint: POST https://api.timewall.io/get-surveys (Authorization: Bearer TIMEWALL_API_KEY)
# Postback URL to configure in TimeWall Dashboard:
# https://rewardriver.online/postback/timewall?userid={userID}&txid={transactionID}&revenue={revenue}&currency={currencyAmount}&hash={hash}&ip={ip}&type={type}&withdrawid={withdrawid}&reason={reason}&offername={offername}&offerdetail={offerdetail}
# ------------------------------------------------------------------------------
TIMEWALL_OID="bbaca457a255e3e2"
TIMEWALL_PLACEMENT_URL="https://timewall.io/users/login?oid={OID}&uid={USER_ID}"
TIMEWALL_API_KEY="replace-with-your-timewall-s2s-survey-api-key"
TIMEWALL_SECRET="replace-with-your-timewall-secret-key"
TIMEWALL_ALLOWED_IPS="18.156.132.55,51.81.120.73,142.111.248.18"
TIMEWALL_COINS_PER_USD="10000"
TIMEWALL_ALLOW_DECIMALS="false"
TIMEWALL_CREDIT_TYPES="credit,complete,1"
TIMEWALL_REVERSAL_TYPES="chargeback,reversal,cancel,subtract,2"
TIMEWALL_NEGATIVE_BALANCE_MODE="allow"
TIMEWALL_MAX_SINGLE_REVENUE_USD="50.00"
TRUSTED_PROXIES="127.0.0.1,::1,cloudflare,vercel"


