# ==============================================================================
# Reward River Environment Configuration (.env.example)
# Copy this file to .env and configure with your production credentials.
# NEVER commit your real .env file or private keys to source control!
# ==============================================================================

# Application Environment & URLs
NODE_ENV=production
PORT=3000
APP_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-secure-random-32-byte-hex-string-for-sessions"

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Database & Auth Configuration
# Get your Supabase URL, Anon Key, and Service Role Key from:
# https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL="https://your-supabase-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_ANON_KEY="your-supabase-anon-key"

# ------------------------------------------------------------------------------
# CPX Research Publisher Credentials
# ------------------------------------------------------------------------------
