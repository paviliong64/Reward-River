{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile information",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 255 },
        "displayName": { "type": "string", "maxLength": 100 },
        "emailVerified": { "type": "boolean" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "externalOpaqueId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "email", "emailVerified", "role", "externalOpaqueId", "createdAt"]
    },
    "RewardLedgerEntry": {
      "title": "RewardLedgerEntry",
      "description": "Immutable ledger record for survey rewards and adjustments",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "providerTxId": { "type": "string", "maxLength": 128 },
        "amountCents": { "type": "integer" },
        "currency": { "type": "string", "maxLength": 10 },
        "entryType": { "type": "string", "enum": ["credit", "reversal", "adjustment"] },
        "status": { "type": "string", "enum": ["pending", "confirmed", "reversed"] },
        "description": { "type": "string", "maxLength": 255 },
        "cpxOfferId": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" },
        "processedAt": { "type": "string" }
      },
      "required": ["id", "userId", "providerTxId", "amountCents", "entryType", "status", "createdAt"]
    },
    "WithdrawalRequest": {
      "title": "WithdrawalRequest",
      "description": "Tether USD (USDT) withdrawal transaction request",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "usdtAddress": { "type": "string", "maxLength": 64 },
        "network": { "type": "string", "enum": ["TRC20", "ERC20"] },
        "amountCents": { "type": "integer" },
        "feeCents": { "type": "integer" },
        "netCents": { "type": "integer" },
        "grossUsdt": { "type": "string" },
        "feeUsdt": { "type": "string" },
        "netUsdt": { "type": "string" },
        "status": { "type": "string", "enum": ["requested", "under_review", "approved", "processing", "paid", "rejected", "failed", "cancelled"] },
        "txHash": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "reviewNotes": { "type": "string", "maxLength": 500 }
      },
      "required": ["id", "userId", "usdtAddress", "network", "amountCents", "feeCents", "netCents", "grossUsdt", "feeUsdt", "netUsdt", "status", "createdAt"]
    },
    "SurveySession": {
      "title": "SurveySession",
      "description": "Record of a survey click or participation session",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "surveyId": { "type": "string", "maxLength": 64 },
        "loiMinutes": { "type": "integer" },
        "estimatedCpiCents": { "type": "integer" },
        "status": { "type": "string", "enum": ["started", "completed", "screened_out", "abandoned"] },
        "startedAt": { "type": "string" },
        "completedAt": { "type": "string" }
      },
      "required": ["id", "userId", "surveyId", "status", "startedAt"]
    },
    "SystemSetting": {
      "title": "SystemSetting",
      "description": "Global system parameters and limits",
      "type": "object",
      "properties": {
        "key": { "type": "string", "maxLength": 64 },
        "value": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string" },
        "updatedBy": { "type": "string", "maxLength": 128 }
      },
      "required": ["key", "value", "updatedAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable log of admin actions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "adminUserId": { "type": "string", "maxLength": 128 },
        "action": { "type": "string", "maxLength": 100 },
        "targetEntity": { "type": "string", "maxLength": 100 },
        "targetId": { "type": "string", "maxLength": 128 },
        "details": { "type": "string", "maxLength": 1000 },
        "ipAddress": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "adminUserId", "action", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Stores private user profile and verification status"
    },
    "/reward_ledger/{ledgerId}": {
      "schema": "RewardLedgerEntry",
      "description": "Immutable ledger of confirmed and pending rewards"
    },
    "/withdrawal_requests/{requestId}": {
      "schema": "WithdrawalRequest",
      "description": "Tether USD (USDT) withdrawal transactions"
    },
    "/survey_sessions/{sessionId}": {
      "schema": "SurveySession",
      "description": "Survey initiation and click sessions"
    },
    "/system_settings/{settingId}": {
      "schema": "SystemSetting",
      "description": "Configurable system settings"
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Auditable log of administrative events"
    }
  }
}
