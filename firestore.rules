rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny all operations
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User profiles: users can read their own profile, update non-critical fields
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      
      // Creation during registration
      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.role == 'user' // Users cannot self-grant admin
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 255;
        
      // Updates: user cannot change role, emailVerified, or externalOpaqueId
      allow update: if (isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 100)
        || isAdmin();

      allow delete: if isAdmin();
    }

    // Reward ledger: strictly immutable. Only trusted server/admin writes.
    match /reward_ledger/{ledgerId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Withdrawal requests: users can read their own and create requests when email is verified
    match /withdrawal_requests/{requestId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      // Client can only submit initial requested status with email verified; approvals/processing are server/admin only
      allow create: if isVerifiedUser() && isValidId(requestId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'requested'
        && request.resource.data.usdtAddress is string
        && request.resource.data.usdtAddress.size() <= 64
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 500; // minimum $5.00
        
      allow update: if isAdmin();
      allow delete: if false; // Financial records are never deleted
    }

    // Survey sessions: users can read and create their own click events
    match /survey_sessions/{sessionId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(sessionId)
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.surveyId is string
        && request.resource.data.surveyId.size() <= 64;
      allow update: if isAdmin();
      allow delete: if false;
    }

    // System settings: anyone authenticated can read public limits; only admin can modify
    match /system_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Admin audit logs: only admins can read and append
    match /admin_audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && isValidId(logId);
      allow update, delete: if false;
    }
  }
}
